#!/usr/bin/env bash
#
# git commit-msg hook: reject commit messages that do not follow Conventional
# Commits. Installed via `make hooks` (sets core.hooksPath to .githooks).
#
# Bypass for emergencies with `git commit --no-verify`; CI re-validates the
# commits on a push/PR, so a bypassed message still has to be fixed there.
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
exec "$repo_root/scripts/validate-conventional-commits.sh" --message-file "$1"
